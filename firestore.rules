rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin dashboard uses authenticated operators.
    // Tighten further with custom claims (role == "admin") in production.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /scans/{scanId} {
      allow read, write: if request.auth != null;
    }
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    match /blogs/{blogId} {
      allow read, write: if request.auth != null;
    }
  }
}
